# ─────────────────────────────────────────────────────────────
# Chemical Process Monitor — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file and rename it to .env
# Fill in your actual values
# NEVER commit .env to GitHub — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# ── Google Gemini API ─────────────────────────────────────────
# Free tier — get your key at https://aistudio.google.com
# No credit card required
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram Bot ──────────────────────────────────────────────
# Create a bot via @BotFather in Telegram
# Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── n8n Encryption Key ────────────────────────────────────────
# Used to encrypt saved credentials in n8n's local database
# Generate a random 32-character string — keep this stable
# PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 32 | % {[char]$_})
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here